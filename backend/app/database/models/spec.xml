<?xml version="1.0" encoding="UTF-8"?>
<spec>
    <title>Database Models</title>
    <description>
        SQLAlchemy models for the Rezynt application database.
        Includes models for users, resumes, templates, and chat messages.
    </description>
    
    <models>
        <model name="User">
            <description>User account model with authentication and subscription data</description>
            <fields>
                <field name="id" type="Integer" primary_key="true" autoincrement="true"/>
                <field name="email" type="String" unique="true" nullable="false"/>
                <field name="hashed_password" type="String" nullable="false"/>
                <field name="is_verified" type="Boolean" default="false"/>
                <field name="is_premium" type="Boolean" default="false"/>
                <field name="created_at" type="TIMESTAMP" server_default="func.now()"/>
                <field name="updated_at" type="TIMESTAMP" server_default="func.now()" onupdate="func.now()"/>
            </fields>
            <relationships>
                <relationship name="resumes" type="one-to-many" target="Resume" back_populates="user"/>
            </relationships>
        </model>
        
        <model name="Template">
            <description>Resume template model for different design options</description>
            <fields>
                <field name="id" type="Integer" primary_key="true" autoincrement="true"/>
                <field name="name" type="String" nullable="false"/>
                <field name="slug" type="String" unique="true" nullable="false"/>
                <field name="description" type="Text" nullable="true"/>
                <field name="thumbnail_url" type="String" nullable="true"/>
                <field name="is_active" type="Boolean" default="true"/>
                <field name="created_at" type="TIMESTAMP" server_default="func.now()"/>
                <field name="updated_at" type="TIMESTAMP" server_default="func.now()" onupdate="func.now()"/>
            </fields>
            <relationships>
                <relationship name="resumes" type="one-to-many" target="Resume" back_populates="template"/>
            </relationships>
        </model>
        
        <model name="Resume">
            <description>Main resume model with all resume data and relationships</description>
            <fields>
                <field name="id" type="Integer" primary_key="true" autoincrement="true"/>
                <field name="user_id" type="Integer" foreign_key="users.id" nullable="false"/>
                <field name="title" type="String(100)" nullable="false"/>
                <field name="template_id" type="Integer" foreign_key="templates.id" nullable="false"/>
                <field name="professional_summary" type="Text" nullable="true"/>
                <field name="conversation_id" type="String(255)" nullable="true"/>
                <field name="from_upload" type="Boolean" nullable="false" default="false"/>
                <field name="created_at" type="TIMESTAMP" server_default="func.now()" nullable="false"/>
                <field name="updated_at" type="TIMESTAMP" server_default="func.now()" onupdate="func.now()" nullable="false"/>
            </fields>
            <relationships>
                <relationship name="user" type="many-to-one" target="User" back_populates="resumes"/>
                <relationship name="template" type="many-to-one" target="Template" back_populates="resumes"/>
                <relationship name="personal_info" type="one-to-one" target="ResumePersonalInfo" back_populates="resume" cascade="all, delete-orphan"/>
                <relationship name="contacts" type="one-to-many" target="ResumeContact" back_populates="resume" cascade="all, delete-orphan"/>
                <relationship name="skills" type="one-to-many" target="ResumeSkill" back_populates="resume" cascade="all, delete-orphan"/>
                <relationship name="experience" type="one-to-many" target="ResumeExperience" back_populates="resume" cascade="all, delete-orphan"/>
                <relationship name="education" type="one-to-many" target="ResumeEducation" back_populates="resume" cascade="all, delete-orphan"/>
                <relationship name="exports" type="one-to-many" target="ResumeExport" back_populates="resume" cascade="all, delete-orphan"/>
                <relationship name="chat_messages" type="one-to-many" target="ChatMessage" back_populates="resume" cascade="all, delete-orphan"/>
            </relationships>
        </model>
        

        
        <model name="ResumePersonalInfo">
            <description>Personal information for a resume</description>
            <fields>
                <field name="id" type="Integer" primary_key="true" autoincrement="true"/>
                <field name="resume_id" type="Integer" foreign_key="resumes.id" unique="true" nullable="false"/>
                <field name="first_name" type="String(100)" nullable="true"/>
                <field name="last_name" type="String(100)" nullable="true"/>
                <field name="location" type="String(255)" nullable="true"/>
            </fields>
            <relationships>
                <relationship name="resume" type="one-to-one" target="Resume" back_populates="personal_info"/>
            </relationships>
        </model>
        
        <model name="ResumeContact">
            <description>Contact information for a resume</description>
            <fields>
                <field name="id" type="Integer" primary_key="true" autoincrement="true"/>
                <field name="resume_id" type="Integer" foreign_key="resumes.id" nullable="false"/>
                <field name="value" type="String(255)" nullable="false"/>
            </fields>
            <relationships>
                <relationship name="resume" type="many-to-one" target="Resume" back_populates="contacts"/>
            </relationships>
        </model>
        
        <model name="ResumeSkill">
            <description>Skills for a resume</description>
            <fields>
                <field name="id" type="Integer" primary_key="true" autoincrement="true"/>
                <field name="resume_id" type="Integer" foreign_key="resumes.id" nullable="false"/>
                <field name="name" type="String(255)" nullable="false"/>
            </fields>
            <relationships>
                <relationship name="resume" type="many-to-one" target="Resume" back_populates="skills"/>
            </relationships>
        </model>
        
        <model name="ResumeExperience">
            <description>Work experience for a resume</description>
            <fields>
                <field name="id" type="Integer" primary_key="true" autoincrement="true"/>
                <field name="resume_id" type="Integer" foreign_key="resumes.id" nullable="false"/>
                <field name="job_title" type="String(255)" nullable="false"/>
                <field name="company" type="String(255)" nullable="false"/>
                <field name="location" type="String(255)" nullable="true"/>
                <field name="start_date" type="Date" nullable="false"/>
                <field name="end_date" type="Date" nullable="true"/>
                <field name="responsibilities" type="JSONB" nullable="true"/>
            </fields>
            <relationships>
                <relationship name="resume" type="many-to-one" target="Resume" back_populates="experience"/>
            </relationships>
        </model>
        
        <model name="ResumeEducation">
            <description>Education for a resume</description>
            <fields>
                <field name="id" type="Integer" primary_key="true" autoincrement="true"/>
                <field name="resume_id" type="Integer" foreign_key="resumes.id" nullable="false"/>
                <field name="degree" type="String(255)" nullable="false"/>
                <field name="institution" type="String(255)" nullable="false"/>
                <field name="location" type="String(255)" nullable="true"/>
                <field name="graduation_date" type="Date" nullable="true"/>
            </fields>
            <relationships>
                <relationship name="resume" type="many-to-one" target="Resume" back_populates="education"/>
            </relationships>
        </model>
        
        <model name="ResumeExport">
            <description>Export history for resumes</description>
            <fields>
                <field name="id" type="Integer" primary_key="true" autoincrement="true"/>
                <field name="resume_id" type="Integer" foreign_key="resumes.id" nullable="false"/>
                <field name="export_format" type="String(50)" nullable="false"/>
                <field name="exported_at" type="TIMESTAMP" server_default="func.now()" nullable="false"/>
                <field name="file_size" type="Integer" nullable="true"/>
                <field name="export_settings" type="JSONB" nullable="true"/>
            </fields>
            <relationships>
                <relationship name="resume" type="many-to-one" target="Resume" back_populates="exports"/>
            </relationships>
        </model>
        
        <model name="ChatMessage">
            <description>Chat messages for resume editing conversations</description>
            <fields>
                <field name="id" type="Integer" primary_key="true" autoincrement="true"/>
                <field name="resume_id" type="Integer" foreign_key="resumes.id" nullable="false" index="true"/>
                <field name="role" type="Enum(MessageRole)" nullable="false"/>
                <field name="content" type="Text" nullable="false"/>
                <field name="created_at" type="DateTime(timezone=True)" server_default="func.now()" nullable="false"/>
            </fields>
            <relationships>
                <relationship name="resume" type="many-to-one" target="Resume" back_populates="chat_messages"/>
            </relationships>
        </model>
        
        <enum name="MessageRole">
            <description>Enum for chat message roles</description>
            <values>
                <value name="USER" value="user"/>
                <value name="AI" value="ai"/>
            </values>
        </enum>
    </models>
    
    <features>
        <feature name="Local Chat Storage">
            <description>Chat messages are stored locally in the database for resume editing conversations</description>
            <implementation>
                - ChatMessage model stores user and AI messages
                - Messages are linked to specific resumes via foreign key
                - MessageRole enum distinguishes between user and AI messages
                - Messages are ordered by creation time for conversation history
                - Cascade delete ensures messages are removed when resume is deleted
            </implementation>
        </feature>
        
        <feature name="Conversation Management">
            <description>Conversation IDs are managed in resume records for OpenAI chat integration</description>
            <implementation>
                - conversation_id field in Resume model
                - Updated when new conversations are created
                - Used for OpenAI chat context
            </implementation>
        </feature>
        
        <feature name="Resume Source Tracking">
            <description>Track whether resume was created from scratch or uploaded from file</description>
            <implementation>
                - from_upload field in Resume model (Boolean, default false)
                - Used to determine chat behavior and context
                - Affects welcome messages and chat behavior
            </implementation>
        </feature>
    </features>
</spec>
