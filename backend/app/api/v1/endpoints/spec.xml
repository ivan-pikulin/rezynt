<?xml version="1.0" encoding="UTF-8"?>
<specification>
    <name>API Endpoints</name>
    <description>
        API эндпоинты для работы с резюме. Включает загрузку файлов, управление шаблонами, получение и обновление резюме и их разделов.
    </description>
    
    <components>
        <component>
            <name>ResumeEndpoints</name>
            <description>
                Эндпоинты для работы с резюме пользователей.
            </description>
            <endpoints>
                <endpoint>
                    <path>/</path>
                    <method>GET</method>
                    <description>
                        Получение всех резюме текущего пользователя. Доступно только пользователям с подтвержденным email.
                    </description>
                    <authentication>VerifiedUser (JWT token + verified email)</authentication>
                    <returns type="List[ResumeInDB]">Список всех резюме пользователя (без связанных данных)</returns>
                    <status_codes>
                        <code>200">Успешное получение списка резюме</code>
                        <code>401">Не авторизован</code>
                        <code>403">Email не подтвержден</code>
                    </status_codes>
                </endpoint>
                
                <endpoint>
                    <path>/</path>
                    <method>POST</method>
                    <description>
                        Создание нового резюме для текущего пользователя. Доступно только пользователям с подтвержденным email.
                    </description>
                    <authentication>VerifiedUser (JWT token + verified email)</authentication>
                    <params>
                        <param name="resume_create" type="ResumeCreate">Данные для создания резюме</param>
                    </params>
                    <returns type="ResumeInDB">Созданное резюме (без связанных данных)</returns>
                    <status_codes>
                        <code>200">Резюме успешно создано</code>
                        <code>401">Не авторизован</code>
                        <code>403">Email не подтвержден</code>
                        <code>404">Шаблон не найден</code>
                    </status_codes>
                    <business_logic>
                        <step>Проверка существования шаблона</step>
                        <step>Создание резюме с user_id текущего пользователя</step>
                    </business_logic>
                </endpoint>
                
                <endpoint>
                    <path>/{resume_id}</path>
                    <method>GET</method>
                    <description>
                        Получение конкретного резюме по ID. Доступно только пользователям с подтвержденным email.
                    </description>
                    <authentication>VerifiedUser (JWT token + verified email)</authentication>
                    <params>
                        <param name="resume_id" type="UUID">ID резюме</param>
                    </params>
                    <returns type="ResumeInDB">Данные резюме (без связанных данных)</returns>
                    <status_codes>
                        <code>200">Успешное получение резюме</code>
                        <code>401">Не авторизован</code>
                        <code>403">Email не подтвержден</code>
                        <code>404">Резюме не найдено или доступ запрещен</code>
                    </status_codes>
                </endpoint>
                
                <endpoint>
                    <path>/{resume_id}/section/{section_name}</path>
                    <method>GET</method>
                    <description>
                        Получение конкретного раздела резюме. Доступно только пользователям с подтвержденным email.
                    </description>
                    <authentication>VerifiedUser (JWT token + verified email)</authentication>
                    <params>
                        <param name="resume_id" type="UUID">ID резюме</param>
                        <param name="section_name" type="str">Название раздела</param>
                    </params>
                    <returns type="Dict[str, Any]">
                        {
                            "resume_id": "uuid",
                            "section_name": "string",
                            "content": "section_data"
                        }
                    </returns>
                    <status_codes>
                        <code>200">Успешное получение раздела</code>
                        <code>401">Не авторизован</code>
                        <code>403">Email не подтвержден</code>
                        <code>404">Резюме или раздел не найден</code>
                    </status_codes>
                </endpoint>
                
                <endpoint>
                    <path>/{resume_id}</path>
                    <method>PUT</method>
                    <description>
                        Полное обновление резюме. Доступно только пользователям с подтвержденным email.
                    </description>
                    <authentication>VerifiedUser (JWT token + verified email)</authentication>
                    <params>
                        <param name="resume_id" type="UUID">ID резюме</param>
                        <param name="resume_update" type="ResumeUpdate">Данные для обновления</param>
                    </params>
                    <returns type="ResumeInDB">Обновленное резюме (без связанных данных)</returns>
                    <status_codes>
                        <code>200">Резюме успешно обновлено</code>
                        <code>401">Не авторизован</code>
                        <code>403">Email не подтвержден</code>
                        <code>404">Резюме не найдено или доступ запрещен</code>
                    </status_codes>
                </endpoint>
                
                <endpoint>
                    <path>/{resume_id}/section/{section_name}</path>
                    <method>PUT</method>
                    <description>
                        Обновление конкретного раздела резюме. Доступно только пользователям с подтвержденным email.
                    </description>
                    <authentication>VerifiedUser (JWT token + verified email)</authentication>
                    <params>
                        <param name="resume_id" type="UUID">ID резюме</param>
                        <param name="section_name" type="str">Название раздела</param>
                        <param name="section_content" type="Dict[str, Any]">Новое содержимое раздела</param>
                    </params>
                    <returns type="Dict[str, Any]">
                        {
                            "resume_id": "uuid",
                            "section_name": "string",
                            "content": "updated_section_data",
                            "message": "Section updated successfully"
                        }
                    </returns>
                    <status_codes>
                        <code>200">Раздел успешно обновлен</code>
                        <code>401">Не авторизован</code>
                        <code>403">Email не подтвержден</code>
                        <code>404">Резюме не найдено или доступ запрещен</code>
                    </status_codes>
                    <business_logic>
                        <step>Проверка принадлежности резюме текущему пользователю</step>
                        <step>Копирование текущего содержимого резюме</step>
                        <step>Обновление конкретного раздела</step>
                        <step>Сохранение обновленного резюме</step>
                    </business_logic>
                </endpoint>
                
                <endpoint>
                    <path>/upload</path>
                    <method>POST</method>
                    <description>
                        Загрузка файла резюме. Доступно только пользователям с подтвержденным email.
                    </description>
                    <authentication>VerifiedUser (JWT token + verified email)</authentication>
                    <params>
                        <param name="file" type="UploadFile">Файл резюме для загрузки</param>
                    </params>
                    <returns type="Dict[str, Any]">
                        {"id": "file_id"} - ID загруженного файла
                    </returns>
                    <status_codes>
                        <code>200">Успешная загрузка</code>
                        <code>401">Не авторизован</code>
                        <code>403">Email не подтвержден</code>
                    </status_codes>
                </endpoint>
                
                <endpoint>
                    <path>/{resume_id}/template/{template_id}</path>
                    <method>PUT</method>
                    <description>
                        Присвоение определенного шаблона резюме. Доступно только пользователям с подтвержденным email.
                    </description>
                    <authentication>VerifiedUser (JWT token + verified email)</authentication>
                    <params>
                        <param name="resume_id" type="UUID">ID резюме</param>
                        <param name="template_id" type="UUID">ID шаблона</param>
                    </params>
                    <returns type="Dict[str, Any]">
                        {
                            "id": "resume_id",
                            "template_id": "template_id", 
                            "message": "Template assigned successfully"
                        }
                    </returns>
                    <status_codes>
                        <code>200">Шаблон успешно присвоен</code>
                        <code>401">Не авторизован</code>
                        <code>403">Email не подтвержден</code>
                        <code>404">Резюме или шаблон не найден</code>
                    </status_codes>
                    <business_logic>
                        <step>Проверка существования шаблона</step>
                        <step>Проверка принадлежности резюме текущему пользователю</step>
                        <step>Обновление резюме с новым шаблоном</step>
                    </business_logic>
                </endpoint>
            </endpoints>
        </component>
    </components>
    
    <dependencies>
        <dependency>app.api.deps (VerifiedUser, AsyncDB)</dependency>
        <dependency>app.database.crud.crud_resume (resume_crud)</dependency>
        <dependency>app.database.crud.crud_template (template_crud)</dependency>
        <dependency>app.schemas.resume (ResumeUpdate, Resume)</dependency>
        <dependency>fastapi (APIRouter, File, UploadFile, HTTPException, status)</dependency>
    </dependencies>
    
    <security>
        <authentication>JWT Bearer Token</authentication>
        <authorization>Email verification required</authorization>
        <access_control>Users can only access their own resumes</access_control>
    </security>
    
    <data_structures>
        <structure>
            <name>Resume</name>
            <description>Основная модель резюме</description>
            <fields>
                <field name="id" type="UUID">Уникальный идентификатор</field>
                <field name="user_id" type="UUID">ID пользователя-владельца</field>
                <field name="title" type="str">Название резюме</field>
                <field name="template_id" type="UUID">ID используемого шаблона</field>
                <field name="content" type="Dict[str, Any]">Содержимое резюме по разделам</field>
                <field name="conversation_id" type="Optional[str]">ID связанной беседы</field>
                <field name="created_at" type="datetime">Дата создания</field>
                <field name="updated_at" type="datetime">Дата последнего обновления</field>
            </fields>
        </structure>
        
        <structure>
            <name>ResumeUpdate</name>
            <description>Модель для обновления резюме</description>
            <fields>
                <field name="title" type="Optional[str]">Название резюме</field>
                <field name="template_id" type="Optional[UUID]">ID шаблона</field>
                <field name="content" type="Optional[Dict[str, Any]]">Содержимое резюме</field>
                <field name="conversation_id" type="Optional[str]">ID беседы</field>
            </fields>
        </structure>
        
        <structure>
            <name>ResumeCreate</name>
            <description>Модель для создания резюме</description>
            <fields>
                <field name="title" type="str">Название резюме</field>
                <field name="template_id" type="UUID">ID шаблона</field>
                <field name="professional_summary" type="Optional[str]">Профессиональное резюме</field>
            </fields>
        </structure>
        
        <structure>
            <name>ResumeInDB</name>
            <description>Модель резюме без связанных данных (для создания)</description>
            <fields>
                <field name="id" type="UUID">Уникальный идентификатор</field>
                <field name="user_id" type="UUID">ID пользователя-владельца</field>
                <field name="title" type="str">Название резюме</field>
                <field name="template_id" type="UUID">ID используемого шаблона</field>
                <field name="professional_summary" type="Optional[str]">Профессиональное резюме</field>
                <field name="conversation_id" type="Optional[str]">ID связанной беседы</field>
                <field name="created_at" type="datetime">Дата создания</field>
                <field name="updated_at" type="datetime">Дата последнего обновления</field>
            </fields>
        </structure>
    </data_structures>
</specification>
