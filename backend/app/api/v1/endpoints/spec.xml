<?xml version="1.0" encoding="UTF-8"?>
<specification>
    <title>API Endpoints Specification</title>
    <description>Specification for all API endpoints in the Rezynt backend</description>
    
    <modules>
        <module name="auth">
            <description>Authentication endpoints for user registration, login, email verification, and password reset</description>
            <endpoints>
                <endpoint path="/auth/signup" method="POST" description="Register new user with email confirmation"/>
                <endpoint path="/auth/login" method="POST" description="User login with email and password"/>
                <endpoint path="/auth/confirm-email" method="GET" description="Confirm user email via token and redirect with tokens for auto-login">
                    <query>
                        <param name="token" required="true" />
                    </query>
                    <redirect success="FRONTEND_BASE_URL/auth/email-confirmed?access_token=&refresh_token=&token_type=bearer" error="FRONTEND_BASE_URL/auth/email-confirmation-error?error=..." />
                </endpoint>
                <endpoint path="/auth/request-password-reset" method="POST" description="Request password reset via email"/>
                <endpoint path="/auth/reset-password" method="POST" description="Reset password using token from email"/>
                <endpoint path="/auth/confirm-email-by-code" method="POST" description="Confirm user email using 6-digit verification code"/>
                <endpoint path="/auth/reset-password-by-code" method="POST" description="Reset password using 6-digit verification code"/>
                <endpoint path="/auth/resend-verification-code" method="POST" description="Resend 6-digit verification code for email confirmation or password reset"/>
                <endpoint path="/auth/refresh" method="POST" description="Refresh access token"/>
            </endpoints>
        </module>
        
        <module name="user">
            <description>User management endpoints</description>
            <endpoints>
                <endpoint path="/user/me" method="GET" description="Get current user profile"/>
                <endpoint path="/user/me" method="PUT" description="Update current user profile"/>
                <endpoint path="/user/onboarding/complete" method="POST" description="Complete user onboarding by saving responses"/>
            </endpoints>
        </module>
        
        <module name="resume">
            <description>Resume CRUD operations and management</description>
            <endpoints>
                <endpoint path="/resume/" method="GET" description="Get all resumes for current user"/>
                <endpoint path="/resume/" method="POST" description="Create new resume (with plan validation)"/>
                <endpoint path="/resume/{resume_id}" method="GET" description="Get specific resume"/>
                <endpoint path="/resume/{resume_id}" method="PUT" description="Update resume"/>
                <endpoint path="/resume/{resume_id}" method="PATCH" description="Partial update resume"/>
                <endpoint path="/resume/{resume_id}" method="DELETE" description="Delete resume (with cascade delete of all related data)"/>
                <endpoint path="/resume/upload" method="POST" description="Upload resume file (with plan validation)"/>
                <endpoint path="/resume/{resume_id}/export-pdf" method="POST" description="Export resume to PDF"/>
                <endpoint path="/resume/{resume_id}/contacts" method="POST" description="Add contact to resume"/>
                <endpoint path="/resume/{resume_id}/contacts/{contact_id}" method="DELETE" description="Remove contact from resume"/>
                <endpoint path="/resume/{resume_id}/skills" method="POST" description="Add skill to resume"/>
                <endpoint path="/resume/{resume_id}/skills/{skill_id}" method="DELETE" description="Remove skill from resume"/>
                <endpoint path="/resume/{resume_id}/experience" method="POST" description="Add experience to resume"/>
                <endpoint path="/resume/{resume_id}/experience/{experience_id}" method="PUT" description="Update experience"/>
                <endpoint path="/resume/{resume_id}/experience/{experience_id}" method="DELETE" description="Remove experience from resume"/>
                <endpoint path="/resume/{resume_id}/education" method="POST" description="Add education to resume"/>
                <endpoint path="/resume/{resume_id}/education/{education_id}" method="PUT" description="Update education"/>
                <endpoint path="/resume/{resume_id}/education/{education_id}" method="DELETE" description="Remove education from resume"/>
            </endpoints>
            <business_rules>
                <rule name="free_plan_resume_limit" description="Free plan users can only create one resume. Premium users can create unlimited resumes."/>
                <rule name="welcome_message" description="Welcome message is automatically created when resume is created"/>
            </business_rules>
            <features>
                <feature name="Welcome Messages" description="Automatic welcome messages are created for new resumes">
                    <implementation>
                        - create_resume: Creates welcome message for manually created resumes
                        - upload_resume: Creates welcome message for uploaded resumes (TODO: different logic)
                    </implementation>
                </feature>
            </features>
        </module>
        
        <module name="ai">
            <description>AI-powered resume update endpoints and resume management</description>
            <endpoints>
                <endpoint path="/ai/{resume_id}/update" method="POST" description="Update resume with AI-generated content"/>
                <endpoint path="/ai/resume/{resume_id}" method="PATCH" description="Patch resume fields (first_name, last_name, location, professional_summary, skills, contacts)"/>
                <endpoint path="/ai/resume/{resume_id}/full" method="GET" description="Get full resume text in structured format with all related data"/>
                <endpoint path="/ai/resume/{resume_id}/experience" method="POST" description="Create new experience entry for resume"/>
                <endpoint path="/ai/resume/{resume_id}/experience/{experience_id}" method="PATCH" description="Update existing experience entry for resume"/>
                <endpoint path="/ai/resume/{resume_id}/education" method="POST" description="Create new education entry for resume"/>
                <endpoint path="/ai/resume/{resume_id}/education/{education_id}" method="PATCH" description="Update existing education entry for resume"/>
            </endpoints>
        </module>
        

        
        <module name="chat">
            <description>Chat functionality for AI interactions with platform integration and streaming support</description>
            <endpoints>
                <endpoint path="/chat/send-message" method="POST" description="Send chat message via platform (blocking mode)"/>
                <endpoint path="/chat/send-message-stream" method="POST" description="Send chat message with streaming response via platform (SSE)"/>
                <endpoint path="/chat/messages/{resume_id}" method="GET" description="Get messages from platform with pagination"/>
            </endpoints>
            <features>
                <feature name="Platform Integration" description="All chat messages are handled via external platform API"/>
                <feature name="No Local Storage" description="Messages are not stored locally, retrieved from platform on demand"/>
                <feature name="Conversation Management" description="Conversation IDs are managed and updated in resume records"/>
                <feature name="Dual Platform Keys" description="Different platform keys used based on resume source">
                    <implementation>
                        - PLATFORM_SCRATCH_APP_KEY: Used for resumes created from scratch
                        - PLATFORM_UPLOAD_APP_KEY: Used for resumes created from uploaded files
                        - Key selection based on resume.from_upload field
                        - Different AI agents provide different welcome messages and behavior
                    </implementation>
                </feature>
                <feature name="Streaming Responses" description="Support for Server-Sent Events (SSE) streaming responses">
                    <implementation>
                        - Uses response_mode: streaming for platform API calls
                        - Processes agent_message events for LLM response chunks
                        - Handles message_end and error events
                        - Updates conversation_id in resume after streaming
                    </implementation>
                </feature>
            </features>
            <streaming>
                <mode>Server-Sent Events (SSE)</mode>
                <content_type>text/event-stream</content_type>
                <events>
                    <event name="chunk" description="Text chunk from LLM response"/>
                    <event name="end" description="Stream completion signal"/>
                    <event name="error" description="Error during streaming"/>
                </events>
                <headers>
                    <header name="Cache-Control" value="no-cache"/>
                    <header name="Connection" value="keep-alive"/>
                    <header name="Access-Control-Allow-Origin" value="*"/>
                    <header name="Access-Control-Allow-Headers" value="*"/>
                </headers>
            </streaming>
            <pagination>
                <type>Platform-based</type>
                <parameters>
                    <parameter name="limit" type="int" default="20" description="Number of messages to return"/>
                    <parameter name="first_id" type="string" optional="true" description="Message ID to start from (null for latest)"/>
                </parameters>
                <usage>
                    <example>GET /chat/messages/123 - Get latest 20 messages from platform</example>
                    <example>GET /chat/messages/123?first_id=456 - Get 20 messages before ID 456 from platform</example>
                </usage>
            </pagination>
        </module>
        
        <module name="health">
            <description>Health check endpoints</description>
            <endpoints>
                <endpoint path="/health" method="GET" description="Health check"/>
            </endpoints>
        </module>
        
        <module name="test_pdf">
            <description>PDF testing endpoints</description>
            <endpoints>
                <endpoint path="/test-pdf" method="POST" description="Test PDF generation"/>
            </endpoints>
        </module>
    </modules>
    
    <authentication>
        <type>JWT Token</type>
        <description>Most endpoints require JWT token authentication via Authorization header</description>
        <exceptions>
            <endpoint path="/auth/signup" description="No authentication required"/>
            <endpoint path="/auth/login" description="No authentication required"/>
            <endpoint path="/auth/confirm-email" description="No authentication required"/>
            <endpoint path="/auth/request-password-reset" description="No authentication required"/>
            <endpoint path="/auth/reset-password" description="No authentication required"/>
            <endpoint path="/auth/confirm-email-by-code" description="No authentication required"/>
            <endpoint path="/auth/reset-password-by-code" description="No authentication required"/>
            <endpoint path="/auth/resend-verification-code" description="No authentication required"/>
            <endpoint path="/health" description="No authentication required"/>
            <endpoint path="/ai/{resume_id}/update" description="Requires API key authentication"/>
            <endpoint path="/ai/resume/{resume_id}/full" description="Requires API key authentication"/>
        </exceptions>
    </authentication>
    
    <response_formats>
        <format name="JSON" description="All responses are in JSON format"/>
        <format name="PDF" description="PDF export endpoints return PDF files"/>
    </response_formats>
    
    <error_handling>
        <standard_errors>
            <error code="400" description="Bad Request - Invalid input data"/>
            <error code="401" description="Unauthorized - Invalid or missing authentication"/>
            <error code="403" description="Forbidden - Insufficient permissions or plan limitations"/>
            <error code="404" description="Not Found - Resource not found"/>
            <error code="422" description="Unprocessable Entity - Validation error"/>
            <error code="500" description="Internal Server Error - Server error"/>
        </standard_errors>
        <business_errors>
            <error code="403" description="Free plan users can only create one resume. Please upgrade to premium to create additional resumes."/>
        </business_errors>
    </error_handling>
</specification>
