<?xml version="1.0" encoding="UTF-8"?>
<specification>
    <name>API Endpoints</name>
    <description>
        API эндпоинты для работы с резюме. Включает загрузку файлов, управление шаблонами, получение и обновление резюме и их разделов.
    </description>
    
    <components>
        <component>
            <name>ResumeEndpoints</name>
            <description>
                Эндпоинты для работы с резюме пользователей.
            </description>
            <endpoints>
                <endpoint>
                    <path>/</path>
                    <method>GET</method>
                    <description>
                        Получение всех резюме текущего пользователя. Доступно только пользователям с подтвержденным email.
                    </description>
                    <authentication>VerifiedUser (JWT token + verified email)</authentication>
                    <returns type="List[ResumeInDB]">Список всех резюме пользователя (без связанных данных)</returns>
                    <status_codes>
                        <code>200">Успешное получение списка резюме</code>
                        <code>401">Не авторизован</code>
                        <code>403">Email не подтвержден</code>
                    </status_codes>
                </endpoint>
                
                <endpoint>
                    <path>/</path>
                    <method>POST</method>
                    <description>
                        Создание нового резюме для текущего пользователя. Доступно только пользователям с подтвержденным email.
                    </description>
                    <authentication>VerifiedUser (JWT token + verified email)</authentication>
                    <params>
                        <param name="resume_create" type="ResumeCreate">Данные для создания резюме</param>
                    </params>
                    <returns type="ResumeInDB">Созданное резюме (без связанных данных)</returns>
                    <status_codes>
                        <code>200">Резюме успешно создано</code>
                        <code>401">Не авторизован</code>
                        <code>403">Email не подтвержден</code>
                        <code>404">Шаблон не найден</code>
                    </status_codes>
                    <business_logic>
                        <step>Проверка существования шаблона</step>
                        <step>Создание резюме с user_id текущего пользователя</step>
                    </business_logic>
                </endpoint>
                
                <endpoint>
                    <path>/{resume_id}</path>
                    <method>GET</method>
                    <description>
                        Получение конкретного резюме по ID. Доступно только пользователям с подтвержденным email.
                    </description>
                    <authentication>VerifiedUser (JWT token + verified email)</authentication>
                    <params>
                        <param name="resume_id" type="UUID">ID резюме</param>
                    </params>
                    <returns type="ResumeInDB">Данные резюме (без связанных данных)</returns>
                    <status_codes>
                        <code>200">Успешное получение резюме</code>
                        <code>401">Не авторизован</code>
                        <code>403">Email не подтвержден</code>
                        <code>404">Резюме не найдено или доступ запрещен</code>
                    </status_codes>
                </endpoint>
                
                <endpoint>
                    <path>/{resume_id}/section/{section_name}</path>
                    <method>GET</method>
                    <description>
                        Получение конкретного раздела резюме. Доступно только пользователям с подтвержденным email.
                    </description>
                    <authentication>VerifiedUser (JWT token + verified email)</authentication>
                    <params>
                        <param name="resume_id" type="UUID">ID резюме</param>
                        <param name="section_name" type="str">Название раздела</param>
                    </params>
                    <returns type="Dict[str, Any]">
                        {
                            "resume_id": "uuid",
                            "section_name": "string",
                            "content": "section_data"
                        }
                    </returns>
                    <status_codes>
                        <code>200">Успешное получение раздела</code>
                        <code>401">Не авторизован</code>
                        <code>403">Email не подтвержден</code>
                        <code>404">Резюме или раздел не найден</code>
                    </status_codes>
                </endpoint>
                
                <endpoint>
                    <path>/{resume_id}</path>
                    <method>PUT</method>
                    <description>
                        Полное обновление резюме. Доступно только пользователям с подтвержденным email.
                    </description>
                    <authentication>VerifiedUser (JWT token + verified email)</authentication>
                    <params>
                        <param name="resume_id" type="UUID">ID резюме</param>
                        <param name="resume_update" type="ResumeUpdate">Данные для обновления</param>
                    </params>
                    <returns type="ResumeInDB">Обновленное резюме (без связанных данных)</returns>
                    <status_codes>
                        <code>200">Резюме успешно обновлено</code>
                        <code>401">Не авторизован</code>
                        <code>403">Email не подтвержден</code>
                        <code>404">Резюме не найдено или доступ запрещен</code>
                    </status_codes>
                </endpoint>
                
                <endpoint>
                    <path>/{resume_id}/section/{section_name}</path>
                    <method>PUT</method>
                    <description>
                        Обновление конкретного раздела резюме. Доступно только пользователям с подтвержденным email.
                    </description>
                    <authentication>VerifiedUser (JWT token + verified email)</authentication>
                    <params>
                        <param name="resume_id" type="UUID">ID резюме</param>
                        <param name="section_name" type="str">Название раздела</param>
                        <param name="section_content" type="Dict[str, Any]">Новое содержимое раздела</param>
                    </params>
                    <returns type="Dict[str, Any]">
                        {
                            "resume_id": "uuid",
                            "section_name": "string",
                            "content": "updated_section_data",
                            "message": "Section updated successfully"
                        }
                    </returns>
                    <status_codes>
                        <code>200">Раздел успешно обновлен</code>
                        <code>401">Не авторизован</code>
                        <code>403">Email не подтвержден</code>
                        <code>404">Резюме не найдено или доступ запрещен</code>
                    </status_codes>
                    <business_logic>
                        <step>Проверка принадлежности резюме текущему пользователю</step>
                        <step>Копирование текущего содержимого резюме</step>
                        <step>Обновление конкретного раздела</step>
                        <step>Сохранение обновленного резюме</step>
                    </business_logic>
                </endpoint>
                
                <endpoint>
                    <path>/upload</path>
                    <method>POST</method>
                    <description>
                        Загрузка файла резюме. Доступно только пользователям с подтвержденным email.
                    </description>
                    <authentication>VerifiedUser (JWT token + verified email)</authentication>
                    <params>
                        <param name="file" type="UploadFile">Файл резюме для загрузки</param>
                    </params>
                    <returns type="Dict[str, Any]">
                        {"id": "file_id"} - ID загруженного файла
                    </returns>
                    <status_codes>
                        <code>200">Успешная загрузка</code>
                        <code>401">Не авторизован</code>
                        <code>403">Email не подтвержден</code>
                    </status_codes>
                </endpoint>
                
                <endpoint>
                    <path>/{resume_id}/template/{template_id}</path>
                    <method>PUT</method>
                    <description>
                        Присвоение определенного шаблона резюме. Доступно только пользователям с подтвержденным email.
                    </description>
                    <authentication>VerifiedUser (JWT token + verified email)</authentication>
                    <params>
                        <param name="resume_id" type="UUID">ID резюме</param>
                        <param name="template_id" type="UUID">ID шаблона</param>
                    </params>
                    <returns type="Dict[str, Any]">
                        {
                            "id": "resume_id",
                            "template_id": "template_id", 
                            "message": "Template assigned successfully"
                        }
                    </returns>
                    <status_codes>
                        <code>200">Шаблон успешно присвоен</code>
                        <code>401">Не авторизован</code>
                        <code>403">Email не подтвержден</code>
                        <code>404">Резюме или шаблон не найден</code>
                    </status_codes>
                    <business_logic>
                        <step>Проверка существования шаблона</step>
                        <step>Проверка принадлежности резюме текущему пользователю</step>
                        <step>Обновление резюме с новым шаблоном</step>
                    </business_logic>
                </endpoint>
                
                <endpoint>
                    <path>/{resume_id}/ai-update</path>
                    <method>POST</method>
                    <description>
                        Обновление резюме с помощью AI-сгенерированного контента через OpenAI structured output. 
                        Все поля опциональны - обновляются только переданные поля. 
                        Для списков (skills, experience, education) элементы добавляются к существующим.
                        Требует валидный API ключ для авторизации.
                    </description>
                    <authentication>API Key (X-API-Key header)</authentication>
                    <params>
                        <param name="resume_id" type="UUID">ID резюме</param>
                        <param name="ai_update" type="OpenAIResumeUpdate">AI-сгенерированные данные для дополнения резюме</param>
                        <param name="X-API-Key" type="string">API ключ в заголовке</param>
                    </params>
                    <returns type="Dict[str, Any]">
                        {
                            "resume_id": "uuid",
                            "message": "Resume updated successfully with AI content",
                            "updated_fields": {
                                "personal_info": "boolean",
                                "professional_summary": "boolean", 
                                "skills_added": "number",
                                "experience_added": "number",
                                "education_added": "number"
                            },
                            "resume": "ResumeInDB"
                        }
                    </returns>
                    <status_codes>
                        <code>200">Резюме успешно обновлено AI-контентом</code>
                        <code>401">Неверный или отсутствующий API ключ</code>
                        <code>404">Резюме не найдено</code>
                    </status_codes>
                    <business_logic>
                        <step>Проверка валидности API ключа</step>
                        <step>Проверка существования резюме</step>
                        <step>Обновление основных полей резюме (professional_summary)</step>
                        <step>Обновление персональной информации (если передана)</step>
                        <step>Добавление новых навыков к существующим</step>
                        <step>Добавление нового опыта работы к существующему</step>
                        <step>Добавление нового образования к существующему</step>
                        <step>Возврат обновленного резюме с информацией об изменениях</step>
                    </business_logic>
                </endpoint>
            </endpoints>
        </component>
    </components>
    
         <dependencies>
         <dependency>app.api.deps (VerifiedUser, AsyncDB, APIKeyVerified)</dependency>
         <dependency>app.database.crud.crud_resume (resume_crud)</dependency>
         <dependency>app.database.crud.crud_template (template_crud)</dependency>
         <dependency>app.schemas.resume (ResumeUpdate, Resume)</dependency>
         <dependency>fastapi (APIRouter, File, UploadFile, HTTPException, status)</dependency>
     </dependencies>
    
    <security>
        <authentication>JWT Bearer Token</authentication>
        <authorization>Email verification required</authorization>
        <access_control>Users can only access their own resumes</access_control>
    </security>
    
    <data_structures>
        <structure>
            <name>Resume</name>
            <description>Основная модель резюме</description>
            <fields>
                <field name="id" type="UUID">Уникальный идентификатор</field>
                <field name="user_id" type="UUID">ID пользователя-владельца</field>
                <field name="title" type="str">Название резюме</field>
                <field name="template_id" type="UUID">ID используемого шаблона</field>
                <field name="content" type="Dict[str, Any]">Содержимое резюме по разделам</field>
                <field name="conversation_id" type="Optional[str]">ID связанной беседы</field>
                <field name="created_at" type="datetime">Дата создания</field>
                <field name="updated_at" type="datetime">Дата последнего обновления</field>
            </fields>
        </structure>
        
        <structure>
            <name>ResumeUpdate</name>
            <description>Модель для обновления резюме</description>
            <fields>
                <field name="title" type="Optional[str]">Название резюме</field>
                <field name="template_id" type="Optional[UUID]">ID шаблона</field>
                <field name="content" type="Optional[Dict[str, Any]]">Содержимое резюме</field>
                <field name="conversation_id" type="Optional[str]">ID беседы</field>
            </fields>
        </structure>
        
        <structure>
            <name>ResumeCreate</name>
            <description>Модель для создания резюме</description>
            <fields>
                <field name="title" type="str">Название резюме</field>
                <field name="template_id" type="UUID">ID шаблона</field>
                <field name="professional_summary" type="Optional[str]">Профессиональное резюме</field>
            </fields>
        </structure>
        
        <structure>
            <name>ResumeInDB</name>
            <description>Модель резюме без связанных данных (для создания)</description>
            <fields>
                <field name="id" type="UUID">Уникальный идентификатор</field>
                <field name="user_id" type="UUID">ID пользователя-владельца</field>
                <field name="title" type="str">Название резюме</field>
                <field name="template_id" type="UUID">ID используемого шаблона</field>
                <field name="professional_summary" type="Optional[str]">Профессиональное резюме</field>
                <field name="conversation_id" type="Optional[str]">ID связанной беседы</field>
                <field name="created_at" type="datetime">Дата создания</field>
                <field name="updated_at" type="datetime">Дата последнего обновления</field>
            </fields>
        </structure>
        
        <structure>
            <name>OpenAIResumeUpdate</name>
            <description>Схема для OpenAI structured output - дополнение резюме AI-контентом</description>
            <fields>
                <field name="personalInfo" type="Optional[OpenAIResumePersonalInfo]">Персональная информация (обновляется только переданные поля)</field>
                <field name="professionalSummary" type="Optional[str]">Профессиональное резюме (заменяет существующее)</field>
                <field name="skills" type="Optional[List[OpenAIResumeSkill]]">Навыки (добавляются к существующим)</field>
                <field name="experience" type="Optional[List[OpenAIResumeExperience]]">Опыт работы (добавляется к существующему)</field>
                <field name="education" type="Optional[List[OpenAIResumeEducation]]">Образование (добавляется к существующему)</field>
            </fields>
        </structure>
        
        <structure>
            <name>OpenAIResumePersonalInfo</name>
            <description>Персональная информация для OpenAI structured output</description>
            <fields>
                <field name="firstName" type="Optional[str]">Имя</field>
                <field name="lastName" type="Optional[str]">Фамилия</field>
                <field name="middleName" type="Optional[str]">Отчество</field>
                <field name="phone" type="Optional[str]">Номер телефона</field>
                <field name="email" type="Optional[str]">Email адрес</field>
                <field name="location" type="Optional[str]">Местоположение</field>
            </fields>
        </structure>
        
        <structure>
            <name>OpenAIResumeSkill</name>
            <description>Навык для OpenAI structured output</description>
            <fields>
                <field name="name" type="str">Название навыка</field>
            </fields>
        </structure>
        
        <structure>
            <name>OpenAIResumeExperience</name>
            <description>Опыт работы для OpenAI structured output</description>
            <fields>
                <field name="jobTitle" type="str">Должность</field>
                <field name="company" type="str">Название компании</field>
                <field name="location" type="Optional[str]">Местоположение работы</field>
                <field name="startDate" type="str">Дата начала (YYYY-MM-DD)</field>
                <field name="endDate" type="Optional[str]">Дата окончания (YYYY-MM-DD)</field>
                <field name="isCurrent" type="bool">Текущая работа</field>
                <field name="responsibilities" type="Optional[List[str]]">Обязанности и достижения</field>
            </fields>
        </structure>
        
        <structure>
            <name>OpenAIResumeEducation</name>
            <description>Образование для OpenAI structured output</description>
            <fields>
                <field name="degree" type="str">Степень или специальность</field>
                <field name="institution" type="str">Название учебного заведения</field>
                <field name="location" type="Optional[str]">Местоположение учебного заведения</field>
                <field name="graduationDate" type="Optional[str]">Дата окончания (YYYY-MM-DD)</field>
            </fields>
        </structure>
    </data_structures>
</specification>
