<?xml version="1.0" encoding="UTF-8"?>
<specification>
    <name>Services Layer</name>
    <description>
        Слой сервисов для бизнес-логики приложения. Содержит классы для работы с пользователями, отправки email и парсинга резюме.
    </description>
    
    <components>
        <component>
            <name>ParseService</name>
            <description>
                Сервис для парсинга резюме с использованием OpenAI Structured Outputs. Читает файлы через markitdown и извлекает структурированные данные с гарантированным форматом через Pydantic модели.
            </description>
            <methods>
                <method>
                    <name>parse_resume_file</name>
                    <description>Парсит файл резюме и возвращает структурированные данные (асинхронно)</description>
                    <params>
                        <param name="file_path" type="str">Путь к файлу резюме</param>
                    </params>
                    <returns type="ParsedResumeData">Структурированные данные резюме</returns>
                    <async>True - использует асинхронные HTTP запросы к OpenAI API</async>
                </method>
                <method>
                    <name>_parse_with_openai_structured</name>
                    <description>Парсит текст резюме через OpenAI Structured Outputs используя OpenAIStructuredResume schema (асинхронно)</description>
                    <params>
                        <param name="text_content" type="str">Текст резюме</param>
                    </params>
                    <returns type="ParsedResumeData">Структурированные данные</returns>
                    <async>True - использует асинхронные HTTP запросы к OpenAI API</async>
                </method>
                <method>
                    <name>_convert_structured_to_parsed</name>
                    <description>Преобразует OpenAIStructuredResume в ParsedResumeData</description>
                    <params>
                        <param name="structured_data" type="OpenAIStructuredResume">Структурированные данные от OpenAI</param>
                    </params>
                    <returns type="ParsedResumeData">Преобразованные данные</returns>
                </method>
                <method>
                    <name>parse_resume_to_unified</name>
                    <description>Парсит файл резюме и возвращает данные в формате UnifiedResume</description>
                    <params>
                        <param name="file_path" type="str">Путь к файлу резюме</param>
                        <param name="user_id" type="int">ID пользователя</param>
                        <param name="title" type="str">Заголовок резюме</param>
                    </params>
                    <returns type="Dict[str, Any]">Данные в формате UnifiedResume</returns>
                </method>
                <method>
                    <name>test_structured_output</name>
                    <description>Тестирует OpenAI Structured Outputs с примером текста (асинхронно)</description>
                    <params>
                        <param name="sample_text" type="str">Пример текста резюме для тестирования</param>
                    </params>
                    <returns type="Dict[str, Any]">Результат парсинга</returns>
                    <async>True - использует асинхронные HTTP запросы к OpenAI API</async>
                </method>
            </methods>
            <configuration>
                <openai_api_key>OPENAI_API_KEY - API ключ OpenAI</openai_api_key>
                <openai_proxy_url>OPENAI_PROXY_URL - URL прокси для OpenAI</openai_proxy_url>
                <model>gpt-4o-mini - Модель OpenAI для парсинга</model>
                <structured_output>Использует OpenAI Structured Outputs с Pydantic моделями для гарантированного формата</structured_output>
            </configuration>
            <schemas>
                <schema name="OpenAIStructuredResume">Pydantic модель для OpenAI Structured Output</schema>
                <schema name="OpenAIStructuredResumeExperience">Модель для опыта работы в structured output</schema>
                <schema name="OpenAIStructuredResumeEducation">Модель для образования в structured output</schema>
            </schemas>
        </component>
        
        <component>
            <name>PlatformChatflow</name>
            <description>
                Сервис для взаимодействия с внешней платформой чат-бота. Отправляет сообщения и получает ответы в блокирующем и потоковом режимах.
            </description>
            <methods>
                <method>
                    <name>chat</name>
                    <description>Отправляет сообщение в чат и получает ответ в блокирующем режиме</description>
                    <params>
                        <param name="user_id" type="str">ID пользователя</param>
                        <param name="text" type="str">Текст сообщения</param>
                        <param name="conversation_id" type="str">ID беседы (опционально)</param>
                        <param name="resume_id" type="str">ID резюме для передачи в inputs (опционально)</param>
                    </params>
                    <returns type="PlatformMessage">Ответ от платформы</returns>
                </method>
                <method>
                    <name>chat_stream</name>
                    <description>Отправляет сообщение в чат и получает ответ в потоковом режиме (SSE)</description>
                    <params>
                        <param name="user_id" type="str">ID пользователя</param>
                        <param name="text" type="str">Текст сообщения</param>
                        <param name="conversation_id" type="str">ID беседы (опционально)</param>
                        <param name="resume_id" type="str">ID резюме для передачи в inputs (опционально)</param>
                    </params>
                    <returns type="AsyncGenerator[str, None]">Поток чанков ответа от платформы</returns>
                    <async>True - использует асинхронные HTTP запросы с потоковым ответом</async>
                </method>
            </methods>
            <configuration>
                <app_key>Ключ приложения платформы</app_key>
                <app_url>URL API платформы</app_url>
                <timeout>Таймаут запроса в секундах</timeout>
            </configuration>
            <streaming>
                <mode>response_mode: streaming - использует Server-Sent Events (SSE)</mode>
                <events>
                    <event name="agent_message">Чанки ответа от LLM</event>
                    <event name="message_end">Сигнал завершения потока</event>
                    <event name="error">Ошибки в потоке</event>
                </events>
            </streaming>
        </component>
        
        <component>
            <name>UserService</name>
            <description>
                Сервис для работы с пользователями. Обеспечивает создание, аутентификацию и подтверждение email пользователей.
            </description>
            <methods>
                <method>
                    <name>create_user</name>
                    <description>Создает нового пользователя и отправляет email для подтверждения</description>
                    <params>
                        <param name="user_in" type="UserCreate">Данные для создания пользователя</param>
                    </params>
                    <returns type="User">Созданный пользователь</returns>
                </method>
                <method>
                    <name>confirm_user</name>
                    <description>Подтверждает email пользователя по токену</description>
                    <params>
                        <param name="token" type="str">Токен подтверждения</param>
                    </params>
                    <returns type="User">Подтвержденный пользователь</returns>
                </method>
                <method>
                    <name>get_user_by_email</name>
                    <description>Получает пользователя по email</description>
                    <params>
                        <param name="email" type="str">Email пользователя</param>
                    </params>
                    <returns type="Optional[User]">Пользователь или None</returns>
                </method>
                <method>
                    <name>authenticate_user</name>
                    <description>Аутентифицирует пользователя</description>
                    <params>
                        <param name="email" type="str">Email пользователя</param>
                        <param name="password" type="str">Пароль пользователя</param>
                    </params>
                    <returns type="Optional[User]">Аутентифицированный пользователь или None</returns>
                </method>
            </methods>
        </component>
        
        <component>
            <name>EmailService</name>
            <description>
                Сервис для отправки email сообщений с поддержкой DKIM подписи. Использует MIMEText и dkim.sign для совместимости с SMTP серверами.
            </description>
            <methods>
                <method>
                    <name>send_email</name>
                    <description>Отправляет email с DKIM подписью используя MIMEText и dkim.sign</description>
                    <params>
                        <param name="to_email" type="str">Email получателя</param>
                        <param name="subject" type="str">Тема письма</param>
                        <param name="body" type="str">Текст письма (поддерживает HTML)</param>
                    </params>
                    <returns type="bool">True если письмо отправлено успешно</returns>
                </method>
                <method>
                    <name>send_confirmation_email</name>
                    <description>Отправляет красивый HTML email для подтверждения регистрации с использованием Jinja2 шаблона</description>
                    <params>
                        <param name="to_email" type="str">Email пользователя</param>
                        <param name="confirmation_token" type="str">Токен для подтверждения</param>
                    </params>
                    <returns type="bool">True если письмо отправлено успешно</returns>
                </method>
                <method>
                    <name>_load_dkim_key</name>
                    <description>Загружает приватный ключ DKIM из файла</description>
                    <returns type="str">Содержимое приватного ключа или пустая строка</returns>
                </method>
            </methods>
            <configuration>
                <smtp_server>Настраивается через EMAIL_HOST в config</smtp_server>
                <smtp_port>Настраивается через EMAIL_PORT в config</smtp_port>
                <sender_email>Настраивается через EMAIL_USERNAME в config</sender_email>
                <domain>Настраивается через EMAIL_DOMAIN в config</domain>
                <dkim_selector>Настраивается через EMAIL_DKIM_SELECTOR в config</dkim_selector>
                <dkim_key_path>Настраивается через EMAIL_DKIM_PRIVATE_KEY_PATH в config</dkim_key_path>
            </configuration>
        </component>
    </components>
    
    <dependencies>
        <dependency>app.core.config</dependency>
        <dependency>app.database.crud</dependency>
        <dependency>app.schemas</dependency>
        <dependency>dkimpy</dependency>
        <dependency>smtplib</dependency>
        <dependency>itsdangerous</dependency>
        <dependency>jinja2</dependency>
        <dependency>openai</dependency>
        <dependency>markitdown</dependency>
    </dependencies>
</specification>
