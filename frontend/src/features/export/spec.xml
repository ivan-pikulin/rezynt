<?xml version="1.0" encoding="UTF-8"?>
<feature>
    <info>
        <name>Export Feature</name>
        <desc>Pricing and export page with Free/Pro plans and download options</desc>
        <tech>React, TypeScript, Material-UI, jsPDF, html2canvas</tech>
    </info>

    <folder_structure>
        /features/export
        ├── components/
        │   ├── DownloadOptions.tsx  # Main download options component
        │   ├── ProModal.tsx         # Pro subscription modal
        │   ├── PricingTable.tsx    # Legacy pricing table (kept for reference)
        │   └── PricingCard.tsx     # Legacy pricing card (kept for reference)
        ├── ExportPage.tsx          # Main export page
        ├── exportApi.ts            # API for pricing and downloads
        └── spec.xml                # This file
    </folder_structure>

    <components>
        <component name="ExportPage" desc="Main page with download options and hidden template for export">
            <props>
                <prop name="none" desc="No props required" />
            </props>
            <features>
                <feature name="Hidden Template" desc="Hidden NumeTemplate for PDF export" />
                <feature name="PDF Export" desc="Direct PDF export using jsPDF and html2canvas" />
            </features>
        </component>
        <component name="DownloadOptions" desc="Two download options: Watermarked and Clean">
            <props>
                <prop name="onExportPDF" desc="Function to handle PDF export" />
                <prop name="isExporting" desc="Boolean to show loading state" />
            </props>
            <features>
                <feature name="Watermarked Download" desc="Free download with watermarks - triggers PDF export" />
                <feature name="Loading State" desc="Shows spinner and disables button during export" />
                <feature name="Clean Download" desc="Pro feature - download without watermarks" />
            </features>
        </component>
        <component name="ProModal" desc="Pro subscription modal with pricing plans">
            <props>
                <prop name="open" desc="Modal open state" />
                <prop name="onClose" desc="Modal close handler" />
            </props>
            <features>
                <feature name="Pro Features List" desc="List of Pro plan benefits" />
                <feature name="Monthly Plan" desc="$29/month subscription" />
                <feature name="Lifetime Plan" desc="$149 one-time payment" />
                <feature name="Continue Button" desc="Proceed with selected plan" />
            </features>
        </component>
        <component name="PricingTable" desc="Legacy pricing table (kept for reference)">
            <props>
                <prop name="none" desc="No props required" />
            </props>
        </component>
        <component name="PricingCard" desc="Legacy pricing card (kept for reference)">
            <props>
                <prop name="title" desc="Plan title (Free/Pro)" />
                <prop name="price" desc="Plan price" />
                <prop name="currency" desc="Currency code" />
                <prop name="features" desc="Array of feature names" />
                <prop name="featureValues" desc="Array of boolean values for features" />
                <prop name="buttonText" desc="Button text" />
                <prop name="buttonVariant" desc="Button variant (contained/outlined)" />
                <prop name="isPopular" desc="Whether this is the popular plan" />
            </props>
        </component>
    </components>

    <api>
        <endpoint name="getPricing" method="GET" path="/export/pricing/">
            <desc>Get available pricing plans</desc>
            <request>None</request>
            <response>Array of pricing plans</response>
        </endpoint>
        <endpoint name="downloadResume" method="POST" path="/export/download/">
            <desc>Download resume with specified plan</desc>
            <request>Plan type (free/pro)</request>
            <response>Download URL and expiration</response>
        </endpoint>
        <endpoint name="exportToPDF" method="POST" path="/export/pdf/">
            <desc>Export resume to PDF</desc>
            <request>None</request>
            <response>Download URL</response>
        </endpoint>
        <endpoint name="exportToWord" method="POST" path="/export/word/">
            <desc>Export resume to Word</desc>
            <request>None</request>
            <response>Download URL</response>
        </endpoint>
        <endpoint name="exportToPNG" method="POST" path="/export/png/">
            <desc>Export resume to PNG</desc>
            <request>None</request>
            <response>Download URL</response>
        </endpoint>
    </api>

    <deps>
        <dep name="Material-UI" purpose="UI components and icons" />
        <dep name="Shared Header" purpose="Common header component" />
        <dep name="jsPDF" purpose="PDF generation library" />
        <dep name="html2canvas" purpose="HTML to canvas conversion for PDF export" />
        <dep name="NumeTemplate" purpose="Template for PDF export" />
        <dep name="TemplateService" purpose="Demo data generation" />
    </deps>

    <implementation>
        <feature name="PDF Export">
            <desc>Direct PDF export functionality using client-side libraries</desc>
            <steps>
                <step>1. Hidden NumeTemplate renders with demo data</step>
                <step>2. html2canvas converts template to canvas</step>
                <step>3. jsPDF creates PDF with A4 format</step>
                <step>4. PDF is saved with filename based on user name</step>
            </steps>
            <files>
                <file>ExportPage.tsx - Main export logic</file>
                <file>DownloadOptions.tsx - Export trigger</file>
            </files>
        </feature>
        <feature name="Loading Indicator">
            <desc>User feedback during PDF generation process</desc>
            <steps>
                <step>1. Button shows spinner (CircularProgress) during export</step>
                <step>2. Card becomes disabled and non-interactive</step>
                <step>3. Text changes to "Generating PDF..." and "Processing..."</step>
                <step>4. Hover effects are disabled during loading</step>
            </steps>
            <files>
                <file>ExportPage.tsx - Loading state management</file>
                <file>DownloadOptions.tsx - Loading UI components</file>
            </files>
        </feature>
    </implementation>
</feature> 