<?xml version="1.0" encoding="UTF-8"?>
<auth_feature>
    <info>
        <desc>Authentication and Authorization Features</desc>
        <tech>React, Material-UI, JWT, React Query</tech>
    </info>

    <folder_structure>
        /features/auth
        ├── index.ts # Feature exports
        ├── components/
        │   └── ParticlesBackground.tsx # Animated background for auth pages
        ├── pages/
        │   ├── Login.tsx # User login page
        │   └── Signup.tsx # User registration page
        ├── hooks/
        │   ├── useAuth.ts # Authentication state and methods
        │   └── usePasswordVisibility.ts # Password field visibility toggle
        └── services/
            └── authService.ts # Authentication API integration
    </folder_structure>

    <functionality>
        <feature name="authentication" desc="User authentication">
            <capability name="login" desc="User login">
                <action name="form" desc="Login form with validation"/>
                <action name="submit" desc="Login request handling"/>
                <action name="error" desc="Error handling and display"/>
                <action name="redirect" desc="Post-login navigation"/>
            </capability>
            <capability name="signup" desc="User registration">
                <action name="form" desc="Registration form with validation"/>
                <action name="submit" desc="Registration request handling"/>
                <action name="error" desc="Error handling and display"/>
                <action name="redirect" desc="Post-registration navigation"/>
            </capability>
            <capability name="token" desc="JWT token management">
                <action name="store" desc="Token storage"/>
                <action name="refresh" desc="Token refresh"/>
                <action name="validate" desc="Token validation"/>
            </capability>
        </feature>

        <feature name="authorization" desc="Access control">
            <capability name="state" desc="Auth state management">
                <action name="check" desc="Check authentication status"/>
                <action name="update" desc="Update auth state"/>
                <action name="clear" desc="Clear auth state"/>
            </capability>
            <capability name="protection" desc="Route protection">
                <action name="guard" desc="Protected route guard"/>
                <action name="redirect" desc="Auth-based redirects"/>
            </capability>
        </feature>
    </functionality>

    <components>
        <component name="Login" desc="Login page">
            <subcomponent name="Form" desc="Login form with validation"/>
            <subcomponent name="ErrorDisplay" desc="Error message display"/>
            <subcomponent name="Background" desc="Animated background"/>
        </component>

        <component name="Signup" desc="Registration page">
            <subcomponent name="Form" desc="Registration form with validation"/>
            <subcomponent name="ErrorDisplay" desc="Error message display"/>
            <subcomponent name="Background" desc="Animated background"/>
        </component>

        <component name="ParticlesBackground" desc="Visual enhancement">
            <subcomponent name="Animation" desc="Particle animation"/>
            <subcomponent name="Layout" desc="Background layout"/>
        </component>
    </components>

    <hooks>
        <hook name="useAuth" desc="Authentication state and methods">
            <method name="login" desc="User login"/>
            <method name="signup" desc="User registration"/>
            <method name="logout" desc="User logout"/>
            <method name="refresh" desc="Token refresh"/>
            <method name="getCurrentUser" desc="Get current user"/>
        </hook>

        <hook name="usePasswordVisibility" desc="Password field visibility">
            <method name="toggle" desc="Toggle password visibility"/>
            <method name="isVisible" desc="Visibility state"/>
        </hook>
    </hooks>

    <deps>
        <dep name="Material-UI" purpose="UI components"/>
        <dep name="React Query" purpose="Data fetching"/>
        <dep name="JWT" purpose="Token handling"/>
        <dep name="React Router" purpose="Navigation"/>
    </deps>

    <security>
        <feature name="tokenStorage" desc="Secure token storage"/>
        <feature name="passwordHashing" desc="Password security"/>
        <feature name="validation" desc="Input validation"/>
    </security>

    <features>
        <feature name="formValidation" desc="Form validation"/>
        <feature name="errorHandling" desc="Error management"/>
        <feature name="animations" desc="Visual enhancements"/>
        <feature name="responsive" desc="Responsive design"/>
    </features>
</auth_feature> 