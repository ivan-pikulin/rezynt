<?xml version="1.0" encoding="UTF-8"?>
<feature>
    <info>
        <name>Refine Feature</name>
        <desc>Page for refining resume with template selection and preview</desc>
        <tech>React, TypeScript, Material-UI</tech>
    </info>

    <folder_structure>
        /features/refine
        ├── components/
        │   ├── TemplateSelector.tsx    # 2-column grid template selector
        │   └── TemplateThumbnail.tsx   # Individual template card with A4 proportions
        ├── RefinePage.tsx              # Main refine page
        ├── refineApi.ts                # API for suggestions and updates
        └── spec.xml                    # This file
    </folder_structure>

    <components>
        <component name="RefinePage" desc="Main page with template selector and resume preview">
            <props>
                <prop name="none" desc="No props required" />
            </props>
            <layout>
                <panel name="Template Selector" width="30%" desc="Left panel with 2-column template grid" />
                <panel name="Resume Preview" width="70%" desc="Right panel with full-size resume preview" />
            </layout>
        </component>
        <component name="TemplateSelector" desc="2-column grid of template options">
            <props>
                <prop name="onTemplateChange" desc="Callback when template is selected" />
            </props>
            <features>
                <feature name="Grid Layout" desc="Templates displayed in 2 columns" />
                <feature name="Scrollable" desc="Vertical scroll when templates overflow" />
            </features>
        </component>
        <component name="TemplateThumbnail" desc="Individual template card with A4 proportions">
            <props>
                <prop name="template" desc="Template configuration" />
                <prop name="resumeData" desc="Resume data for preview" />
                <prop name="isSelected" desc="Selection state" />
                <prop name="onSelect" desc="Selection callback" />
            </props>
            <features>
                <feature name="A4 Proportions" desc="Container with 1:1.414 aspect ratio" />
                <feature name="Template Name" desc="Template name displayed below preview" />
                <feature name="Selection State" desc="Visual feedback for selected template" />
            </features>
        </component>
    </components>

    <api>
        <endpoint name="getSuggestions" method="POST" path="/refine/suggestions/">
            <desc>Get AI suggestions for resume improvement</desc>
            <request>Context string</request>
            <response>Array of suggestions</response>
        </endpoint>
        <endpoint name="updateResume" method="PUT" path="/refine/update-resume/">
            <desc>Update resume data</desc>
            <request>Resume data object</request>
            <response>Success status</response>
        </endpoint>
        <endpoint name="applyTemplate" method="POST" path="/refine/apply-template/">
            <desc>Apply template to resume</desc>
            <request>Template ID</request>
            <response>Success status</response>
        </endpoint>
    </api>

    <deps>
        <dep name="Material-UI" purpose="UI components" />
        <dep name="Shared Header" purpose="Common header component" />
        <dep name="Shared ResumeRenderer" purpose="Resume preview component" />
        <dep name="Shared TemplateService" purpose="Template management" />
    </deps>
</feature> 