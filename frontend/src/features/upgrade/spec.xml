<?xml version="1.0" encoding="UTF-8"?>
<feature>
  <name>Upgrade Page</name>
  <description>
    A full-page upgrade experience that showcases the user's resume preview on the left and presents the benefits, pricing, and value proposition of upgrading on the right. Designed to convert free users to paid customers with a focus on a 3-month one-time payment model.
  </description>

  <route>
    <path>/upgrade</path>
    <access>public with OnboardingGuard</access>
  </route>

  <components>
    <component name="UpgradePage">
      <location>frontend/src/features/upgrade/UpgradePage.tsx</location>
      <purpose>Main upgrade page component with resume preview and upgrade information</purpose>
      
      <layout>
        <section name="Header">
          <description>Header component with back navigation</description>
        </section>
        
        <section name="Resume Preview">
          <position>Left side (400px width)</position>
          <description>Shows user's current resume using ResumeRenderer</description>
          <visibility>Desktop only (hidden on mobile)</visibility>
        </section>
        
        <section name="Upgrade Content">
          <position>Right side (flex: 1, max-width: 600px)</position>
          <elements>
            <element>Title and subtitle explaining the 3-month value proposition</element>
            <element>Feature list with checkmark icons</element>
            <element>Pricing card with 3-month access details</element>
            <element>CTA button linking to Stripe payment</element>
            <element>Bottom note about security and no-hassle policy</element>
          </elements>
        </section>
      </layout>

      <features>
        <feature>One-time payment model (3 months access)</feature>
        <feature>Resume preview integration</feature>
        <feature>Stripe payment integration</feature>
        <feature>Responsive design (single screen height)</feature>
        <feature>Back navigation to previous page</feature>
      </features>
    </component>
  </components>

  <integrations>
    <integration>
      <name>Stripe Payment</name>
      <url>https://buy.stripe.com/7sY28t1jrf0n1mt3g743S0K</url>
      <description>Direct link to Stripe checkout for 3-month access purchase</description>
    </integration>
    
    <integration>
      <name>Resume Preview</name>
      <component>ResumeRenderer</component>
      <description>Displays user's current resume using selected template</description>
    </integration>
  </integrations>

  <translations>
    <file>frontend/src/shared/i18n/en.json</file>
    <file>frontend/src/shared/i18n/pt.json</file>
    <section>upgrade</section>
    <keys>
      <key>upgrade.title</key>
      <key>upgrade.subtitle</key>
      <key>upgrade.features.*</key>
      <key>upgrade.pricing.*</key>
      <key>upgrade.buttons.*</key>
      <key>upgrade.bottomNote</key>
    </keys>
  </translations>

  <styling>
    <theme>Uses COLORS from shared/theme/theme.ts</theme>
    <layout>
      <container>
        <height>100vh</height>
        <display>flex column</display>
        <background>COLORS.grey[50]</background>
      </container>
      <content>
        <layout>flex row with gap</layout>
        <alignment>centered vertically</alignment>
        <fits>Single screen height</fits>
      </content>
    </layout>
  </styling>

  <navigation>
    <from>
      <source>PaywallModal (replaced)</source>
      <source>Profile Settings - Subscription Section</source>
      <source>Chat Window - Credits chip</source>
      <source>Export Page - Download Options</source>
      <source>Any paywall trigger in the application</source>
    </from>
    <to>
      <destination>Stripe Checkout (external)</destination>
    </to>
  </navigation>

  <replaced_components>
    <component>
      <name>PaywallModal</name>
      <location>frontend/src/shared/components/PaywallModal.tsx</location>
      <status>Deprecated - replaced with full page experience</status>
      <migration>All instances of PaywallModal now navigate to /upgrade instead</migration>
    </component>
  </replaced_components>

  <value_proposition>
    <focus>3-month access with one-time payment</focus>
    <reasoning>Most job searches complete within 3 months</reasoning>
    <benefits>
      <benefit>No subscription cancellation hassle</benefit>
      <benefit>No recurring charges</benefit>
      <benefit>Pay once, use for job search duration</benefit>
    </benefits>
  </value_proposition>

  <dependencies>
    <dependency>@mui/material</dependency>
    <dependency>react-router-dom</dependency>
    <dependency>react-i18next</dependency>
    <dependency>shared/components/ResumeRenderer</dependency>
    <dependency>shared/components/Header</dependency>
    <dependency>shared/hooks/useResumeQuery</dependency>
    <dependency>shared/theme/theme</dependency>
  </dependencies>
</feature>

