<?xml version="1.0" encoding="UTF-8"?>
<theme>
    <info>
        <desc>Application Theme Configuration</desc>
        <tech>Material-UI, Emotion</tech>
    </info>

    <folder_structure>
        /shared/theme
        ├── theme.ts # Theme configuration
        └── ThemeContext.tsx # Theme context provider
    </folder_structure>

    <components>
        <component name="ThemeProvider" desc="Theme context provider">
            <feature name="context" desc="Theme context management"/>
            <feature name="provider" desc="Theme provider component"/>
        </component>

        <component name="ThemeConfig" desc="Theme configuration">
            <feature name="palette" desc="Color palette configuration"/>
            <feature name="typography" desc="Typography settings"/>
            <feature name="spacing" desc="Spacing system"/>
            <feature name="breakpoints" desc="Responsive breakpoints"/>
            <feature name="components" desc="Component style overrides"/>
        </component>
    </components>

    <theme_elements>
        <element name="palette" desc="Color system">
            <color name="primary" desc="Primary brand color"/>
            <color name="secondary" desc="Secondary brand color"/>
            <color name="error" desc="Error state color"/>
            <color name="warning" desc="Warning state color"/>
            <color name="info" desc="Information state color"/>
            <color name="success" desc="Success state color"/>
            <color name="grey" desc="Grey scale"/>
            <color name="text" desc="Text colors"/>
            <color name="background" desc="Background colors"/>
        </element>

        <element name="typography" desc="Typography system">
            <type name="h1" desc="Heading 1"/>
            <type name="h2" desc="Heading 2"/>
            <type name="h3" desc="Heading 3"/>
            <type name="h4" desc="Heading 4"/>
            <type name="h5" desc="Heading 5"/>
            <type name="h6" desc="Heading 6"/>
            <type name="subtitle1" desc="Subtitle 1"/>
            <type name="subtitle2" desc="Subtitle 2"/>
            <type name="body1" desc="Body text 1"/>
            <type name="body2" desc="Body text 2"/>
            <type name="button" desc="Button text"/>
            <type name="caption" desc="Caption text"/>
            <type name="overline" desc="Overline text"/>
        </element>

        <element name="spacing" desc="Spacing system">
            <spacing name="unit" desc="Base spacing unit"/>
            <spacing name="grid" desc="Grid spacing"/>
            <spacing name="component" desc="Component spacing"/>
        </element>

        <element name="breakpoints" desc="Responsive breakpoints">
            <breakpoint name="xs" desc="Extra small devices"/>
            <breakpoint name="sm" desc="Small devices"/>
            <breakpoint name="md" desc="Medium devices"/>
            <breakpoint name="lg" desc="Large devices"/>
            <breakpoint name="xl" desc="Extra large devices"/>
        </element>
    </theme_elements>

    <deps>
        <dep name="Material-UI" purpose="Theme system"/>
        <dep name="Emotion" purpose="Styled components"/>
        <dep name="React" purpose="Context provider"/>
    </deps>

    <features>
        <feature name="darkMode" desc="Dark mode support"/>
        <feature name="customization" desc="Theme customization"/>
        <feature name="responsive" desc="Responsive design"/>
        <feature name="consistency" desc="Design consistency"/>
    </features>
</theme> 