<?xml version="1.0" encoding="UTF-8"?>
<frontend>
    <info>
        <desc>Family Tree Frontend Application</desc>
        <tech>React, TypeScript, Vite, Material-UI, React Query</tech>
    </info>

    <folder_structure>
        /frontend
        ├── src/ # Source code
        │   ├── features/ # Feature-based modules
        │   ├── services/ # API and other services
        │   ├── shared/ # Shared components and utilities
        │   └── app/ # Application setup and routing
        ├── public/ # Static assets
        ├── build/ # Build output
        ├── package.json # Dependencies and scripts
        ├── tsconfig.json # TypeScript configuration
        ├── vite.config.ts # Vite configuration
        ├── nginx.conf # Nginx configuration
        └── Dockerfile # Container configuration
    </folder_structure>

    <components>
        <module name="features" desc="Feature-based modules">
            <feature name="familyTree" desc="Family tree visualization and management"/>
            <feature name="admin" desc="Administrative features"/>
            <feature name="auth" desc="Authentication and authorization"/>
        </module>
        <module name="services" desc="API and service integrations">
            <service name="api" desc="Backend API integration"/>
            <service name="i18n" desc="Internationalization"/>
        </module>
        <module name="shared" desc="Shared components and utilities">
            <component name="components" desc="Reusable UI components"/>
            <component name="theme" desc="Theme configuration"/>
        </module>
    </components>

    <deps>
        <dep name="React" purpose="UI framework"/>
        <dep name="TypeScript" purpose="Type safety"/>
        <dep name="Vite" purpose="Build tool"/>
        <dep name="Material-UI" purpose="UI components"/>
        <dep name="React Query" purpose="Data fetching"/>
        <dep name="React Router" purpose="Routing"/>
        <dep name="i18next" purpose="Internationalization"/>
        <dep name="ReactFlow" purpose="Tree visualization"/>
        <dep name="Axios" purpose="HTTP client"/>
    </deps>

    <build>
        <tool name="Vite" purpose="Development and build"/>
        <tool name="TypeScript" purpose="Type checking"/>
        <tool name="ESLint" purpose="Code linting"/>
        <tool name="Nginx" purpose="Production serving"/>
        <tool name="Docker" purpose="Containerization"/>
    </build>
</frontend> 