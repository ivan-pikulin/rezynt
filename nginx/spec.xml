<?xml version="1.0" encoding="UTF-8"?>
<specification>
    <name>Nginx Configuration for Rezynt.com</name>
    <description>
        Nginx reverse proxy configuration for the Rezynt AI resume builder application.
        Handles SSL termination, load balancing, and routing between frontend and backend services.
        Supports both main domain (rezynt.com) and app subdomain (app.rezynt.com).
    </description>
    
    <features>
        <feature>
            <name>SSL/TLS Termination</name>
            <description>
                - SSL certificate management for rezynt.com, www.rezynt.com, and app.rezynt.com
                - Automatic HTTP to HTTPS redirect for all domains
                - Separate SSL certificates for main domain and app subdomain
                - Modern SSL configuration with TLS 1.2/1.3
                - HSTS header for enhanced security
            </description>
        </feature>
        
        <feature>
            <name>Reverse Proxy</name>
            <description>
                - Frontend routing to React SPA for both domains
                - Backend API routing to FastAPI for both domains
                - WebSocket support for real-time features
                - Separate server blocks for main domain and app subdomain
            </description>
        </feature>
        
        <feature>
            <name>Security Headers</name>
            <description>
                - X-Frame-Options: SAMEORIGIN
                - X-XSS-Protection: 1; mode=block
                - X-Content-Type-Options: nosniff
                - Content-Security-Policy with appropriate directives
                - Referrer-Policy: no-referrer-when-downgrade
            </description>
        </feature>
        
        <feature>
            <name>Health Monitoring</name>
            <description>
                - /health endpoint for nginx status on both domains
                - SSL certificate validation script
                - Integration with deployment pipeline health checks
            </description>
        </feature>
        
        <feature>
            <name>Performance Optimization</name>
            <description>
                - Gzip compression for text-based content
                - Optimized proxy timeouts
                - Client max body size configuration
                - Keep-alive connections
            </description>
        </feature>
        
        <feature>
            <name>Analytics Proxy (PostHog)</name>
            <description>
                - Reverse proxy for PostHog analytics to bypass ad blockers
                - /ingest/ endpoint proxies to us.i.posthog.com
                - /static/ endpoint proxies to us-assets.i.posthog.com/static/
                - CORS headers configured for cross-origin requests
                - Static assets cached for 1 hour for better performance
                - First-party context for improved tracking accuracy
            </description>
        </feature>
    </features>
    
    <configuration>
        <domains>
            <domain>rezynt.com</domain>
            <domain>www.rezynt.com</domain>
            <domain>app.rezynt.com</domain>
        </domains>
        
        <ssl_certificates>
            <main_domain>
                <path>/etc/letsencrypt/live/rezynt.com/fullchain.pem</path>
                <private_key>/etc/letsencrypt/live/rezynt.com/privkey.pem</private_key>
            </main_domain>
            <app_subdomain>
                <path>/etc/letsencrypt/live/app.rezynt.com/fullchain.pem</path>
                <private_key>/etc/letsencrypt/live/app.rezynt.com/privkey.pem</private_key>
            </app_subdomain>
        </ssl_certificates>
        
        <upstream_services>
            <service name="frontend" port="80"/>
            <service name="backend" port="8000"/>
            <service name="landing" port="80"/>
        </upstream_services>
        
        <routes>
            <route path="/" target="frontend" description="React SPA (app.rezynt.com)"/>
            <route path="/api" target="backend" description="FastAPI backend (app.rezynt.com)"/>
            <route path="/docs" target="backend" description="API documentation (app.rezynt.com)"/>
            <route path="/ingest/" target="us.i.posthog.com" description="PostHog analytics proxy (app.rezynt.com)"/>
            <route path="/static/" target="us-assets.i.posthog.com" description="PostHog static assets proxy (app.rezynt.com)"/>
            <route path="/" target="landing" description="Landing pages (rezynt.com)"/>
            <route path="/health" target="nginx" description="Health check"/>
        </routes>
        
        <server_blocks>
            <block>
                <name>Main Domain</name>
                <domains>rezynt.com, www.rezynt.com</domains>
                <ssl>enabled</ssl>
                <http_redirect>enabled</http_redirect>
                <upstream>landing</upstream>
            </block>
            <block>
                <name>App Subdomain</name>
                <domains>app.rezynt.com</domains>
                <ssl>enabled</ssl>
                <http_redirect>enabled</http_redirect>
                <upstreams>
                    <upstream path="/" target="frontend"/>
                    <upstream path="/api" target="backend"/>
                    <upstream path="/docs" target="backend"/>
                    <upstream path="/ingest/" target="us.i.posthog.com" description="PostHog analytics"/>
                    <upstream path="/static/" target="us-assets.i.posthog.com" description="PostHog assets"/>
                </upstreams>
            </block>
        </server_blocks>
    </configuration>
    
    <deployment>
        <docker_image>nginx:alpine</docker_image>
        <ports>
            <port>80:80</port>
            <port>443:443</port>
        </ports>
        <volumes>
            <volume>./nginx/nginx.conf:/etc/nginx/nginx.conf:ro</volume>
            <volume>letsencrypt:/etc/letsencrypt:ro</volume>
            <volume>certbot-www:/var/www/certbot:ro</volume>
        </volumes>
        <depends_on>
            <service>backend</service>
            <service>frontend</service>
            <service>landing</service>
        </depends_on>
    </deployment>
    
    <maintenance>
        <ssl_renewal>
            <method>Let's Encrypt with certbot container</method>
            <frequency>Automatic renewal every 12 hours</frequency>
            <automation>Docker container with certbot/certbot:latest</automation>
            <webroot>/var/www/certbot</webroot>
        </ssl_renewal>
        
        <monitoring>
            <health_check>/health</health_check>
            <ssl_check>check-ssl.sh script in nginx directory</ssl_check>
            <log_location>/var/log/nginx/</log_location>
        </monitoring>
    </maintenance>
    
    <landing_configuration>
        <name>Landing Page Nginx Config</name>
        <file>landing.conf</file>
        <description>
            Separate nginx configuration for the landing page container.
            Serves static HTML/CSS/JS files built from the landing/ directory.
        </description>
        <features>
            <feature>Static file serving from /usr/share/nginx/html</feature>
            <feature>Health check endpoint at /health</feature>
            <feature>Static asset caching (30 days for images, CSS, JS)</feature>
            <feature>SPA fallback to index.html for routing</feature>
        </features>
        <deployment>
            <build_process>
                Built using Vite during GitHub Actions deployment.
                Output directory: landing_html/
                Copied to server via SCP and mounted to landing container.
            </build_process>
            <container>
                <image>nginx:alpine</image>
                <volumes>
                    <volume>./landing_html:/usr/share/nginx/html:ro</volume>
                    <volume>./nginx/landing.conf:/etc/nginx/conf.d/default.conf:ro</volume>
                </volumes>
            </container>
        </deployment>
    </landing_configuration>
</specification> 